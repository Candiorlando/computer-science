# Required for the AI coach
ANTHROPIC_API_KEY=sk-ant-...

# Optional: CareerOneStop API (free, US Dept of Labor) — used for local job openings
# Sign up: https://www.careeronestop.org/Developers/WebAPI/registration.aspx
CAREERONESTOP_USER_ID=
CAREERONESTOP_TOKEN=

# Stripe (test mode) — platform payments & subscriptions
# Get your keys from the Stripe Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret — from your endpoint in the Dashboard, or `stripe listen`
STRIPE_WEBHOOK_SECRET=
# Country for new connected accounts, and default currency
CONNECTED_ACCOUNT_COUNTRY=US
CURRENCY=usd

# Zoom (Server-to-Server OAuth app) — real video meetings for appointments.
# Without these, telehealth sessions use a keyless Jitsi room instead.
# Create at: https://marketplace.zoom.us (Build App > Server-to-Server OAuth)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Google Calendar sync — lets counselors connect their Google Calendar so
# new bookings sync automatically. Create an OAuth Client ID (Web
# application) at https://console.cloud.google.com, add
# https://www.pathwayspro.app/api/calendar/google/callback as an
# authorized redirect URI, and enable the Google Calendar API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Outlook / Microsoft 365 Calendar sync — Azure AD app registration at
# https://portal.azure.com, redirect URI
# https://www.pathwayspro.app/api/calendar/outlook/callback, Microsoft
# Graph delegated permissions Calendars.ReadWrite + offline_access.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=
